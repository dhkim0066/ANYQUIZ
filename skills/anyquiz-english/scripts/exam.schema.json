{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnyQuiz exam v2",
  "description": "구조와 값의 범위만 정의한다. 역할(source/generated)별 필수 항목과 작성 규칙은 validate_schema.py가 검사한다.",
  "type": "object",
  "required": [
    "schema_version",
    "role",
    "title",
    "mode",
    "language",
    "option_marker",
    "source_level",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "role": {
      "enum": [
        "source",
        "generated"
      ]
    },
    "answer_key": {
      "enum": [
        "provided",
        "solved",
        "none"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "format",
        "passage",
        "vocab"
      ]
    },
    "language": {
      "enum": [
        "ko",
        "en"
      ]
    },
    "explanation_language": {
      "enum": [
        "ko",
        "en"
      ]
    },
    "option_marker": {
      "enum": [
        "circled",
        "letter",
        "number"
      ]
    },
    "source_level": {
      "$ref": "#/$defs/level"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "first",
          "last"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string"
          },
          "first": {
            "type": "integer",
            "minimum": 1
          },
          "last": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "level": {
      "enum": [
        "A1",
        "A2",
        "A2+",
        "B1",
        "B1+",
        "B2",
        "B2+",
        "C1",
        "C2"
      ]
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "type",
        "subtype",
        "level",
        "points",
        "topic_tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "cloze",
            "vocab",
            "reading"
          ]
        },
        "subtype": {
          "enum": [
            "single-blank",
            "multi-blank",
            "word-bank",
            "word-list",
            "meaning-write",
            "synonym-match",
            "definition-match",
            "main-idea",
            "title",
            "blank-inference",
            "detail",
            "reference",
            "implied-meaning",
            "inference",
            "order",
            "insertion",
            "irrelevant",
            "summary"
          ]
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "points": {
          "type": "number",
          "minimum": 0
        },
        "points_per_part": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "topic_tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "passage": {
          "type": "string",
          "minLength": 1
        },
        "given": {
          "type": "string",
          "minLength": 1
        },
        "prompt_text": {
          "type": "string",
          "minLength": 1
        },
        "footnote": {
          "type": "string",
          "minLength": 1
        },
        "passage_group": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "group_instruction": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "option_language": {
          "enum": [
            "ko",
            "en"
          ]
        },
        "polarity": {
          "enum": [
            "match",
            "mismatch"
          ]
        },
        "answer": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "distractor_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "word_bank": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "match_left": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "match_right": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "match_left_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "match_right_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocab_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "word",
              "pos",
              "meaning",
              "example",
              "derived"
            ]
          }
        },
        "words_from_passages": {
          "type": "boolean"
        },
        "vocab_entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "word"
            ],
            "additionalProperties": false,
            "properties": {
              "word": {
                "type": "string",
                "minLength": 1
              },
              "pos": {
                "type": "string"
              },
              "meaning": {
                "type": "string"
              },
              "example": {
                "type": "string"
              },
              "derived": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
