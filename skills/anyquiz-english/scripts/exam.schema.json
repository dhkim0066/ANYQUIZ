{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnyQuiz exam",
  "type": "object",
  "required": ["title", "mode", "language", "source_level", "items"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["format", "passage", "vocab"] },
    "language": { "enum": ["ko", "en"] },
    "source_level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
    "total_points": { "type": "number", "minimum": 0 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "type", "subtype", "level", "points", "topic_tags", "stem", "answer", "explanation"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["cloze", "vocab", "reading"] },
        "subtype": {
          "enum": [
            "single-blank", "multi-blank", "word-bank",
            "word-list", "synonym-match", "definition-match",
            "main-idea", "title", "blank-inference", "detail",
            "order", "insertion", "irrelevant", "summary"
          ]
        },
        "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "points": { "type": "number", "minimum": 0 },
        "topic_tags": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "passage": { "type": "string" },
        "passage_words": { "type": "integer", "minimum": 0 },
        "stem": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array", "minItems": 4, "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "answer": { "type": ["integer", "string"] },
        "explanation": { "type": "string", "minLength": 1 },
        "distractor_notes": { "type": "array", "items": { "type": "string" } },
        "vocab_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["word", "pos", "meaning_ko", "example"],
            "additionalProperties": false,
            "properties": {
              "word": { "type": "string", "minLength": 1 },
              "pos": { "type": "string" },
              "meaning_ko": { "type": "string" },
              "meaning_en": { "type": "string" },
              "example": { "type": "string", "minLength": 1 },
              "derived": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "reading" } } },
          "then": { "required": ["passage", "passage_words", "options", "distractor_notes"] }
        },
        {
          "if": { "properties": { "type": { "const": "cloze" } } },
          "then": { "required": ["passage", "passage_words"] }
        },
        {
          "if": { "properties": { "type": { "const": "vocab" }, "subtype": { "const": "word-list" } } },
          "then": { "required": ["vocab_entries"] }
        }
      ]
    }
  }
}
